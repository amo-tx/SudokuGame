<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/board_bg">

    <!-- Top toolbar - 增大高度和按钮尺寸，避免与系统状态栏重叠 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/toolbar_bg"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:minHeight="56dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/toolbar_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 暂停按钮 -->
        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_pause"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pause"
            android:layout_marginEnd="4dp"
            app:tint="@color/toolbar_text" />

        <!-- 主菜单按钮 -->
        <ImageButton
            android:id="@+id/btnNewGame"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/main_menu"
            android:layout_marginEnd="4dp"
            app:tint="@color/toolbar_text" />
    </LinearLayout>

    <!-- 第二行操作栏：难度/扫描/主题 - 独立一行，触控区域更大 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/toolbar_bg"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spinnerDifficulty"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:popupBackground="@color/board_bg" />

        <ImageButton
            android:id="@+id/btnScan"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_scan"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/scan_sudoku"
            android:layout_marginEnd="4dp"
            app:tint="@color/toolbar_text" />

        <ImageButton
            android:id="@+id/btnTheme"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_theme"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/theme_settings"
            app:tint="@color/toolbar_text" />
    </LinearLayout>

    <!-- Info bar: timer and mistakes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/timer_default"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_given" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mistakes"
                android:textSize="14sp"
                android:textColor="@color/text_note" />

            <TextView
                android:id="@+id/tvMistakes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0/3"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_error" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sudoku board -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <com.sudoku.game.view.SudokuBoardView
            android:id="@+id/sudokuBoard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Number pad 1-9 (buttons generated in code) -->
    <LinearLayout
        android:id="@+id/numberPad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp" />

    <!-- Control buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErase"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/erase"
            android:textColor="@color/text_given"
            app:icon="@android:drawable/ic_input_delete"
            app:iconTint="@color/text_given" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNote"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/note"
            android:textColor="@color/text_given"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconTint="@color/text_given" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHint"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hint"
            android:textColor="@color/text_given"
            app:icon="@android:drawable/ic_menu_help"
            app:iconTint="@color/text_given" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSolve"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/solve"
            android:textColor="@color/text_given"
            app:icon="@android:drawable/ic_menu_send"
            app:iconTint="@color/text_given" />
    </LinearLayout>

</LinearLayout>